# ============================================================
#  GianQR - Variables de entorno del backend
#  Copia este archivo como .env y completa los valores
# ============================================================

# Servidor (Railway setea PORT automaticamente)
PORT=4000
NODE_ENV=development

# JWT
JWT_SECRET=cambiar_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# URL del frontend (para CORS y links en QR/email)
# En produccion: https://tu-app.vercel.app
FRONTEND_URL=http://localhost:5173

# Ruta del archivo SQLite.
# En Railway con volumen montado: /data/gianqr.db
# En local: dejar vacio para usar ../../../database/gianqr.sqlite
DB_PATH=

# Email (opcional - para enviar QRs por correo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password
EMAIL_FROM=GianQR <tu_email@gmail.com>

# 2FA — lista (CSV) de roles para los que el 2FA es OBLIGATORIO. Si el
# rol del usuario esta en esta lista y no tiene 2FA habilitado, la app
# lo redirige a /configuracion/2fa y bloquea el resto hasta que active.
# Default vacio = 2FA opcional para todos. Recomendacion: TFA_REQUIRED_ROLES=admin,owner
TFA_REQUIRED_ROLES=
TFA_ISSUER=GianQR
