# ============================================================
#  GianQR - Variables de entorno del backend
#  Copiá este archivo como .env y completá los valores
# ============================================================

# Servidor
PORT=4000
NODE_ENV=development

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gianqr
DB_USER=postgres
DB_PASSWORD=tu_password_aqui

# JWT
JWT_SECRET=cambiar_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# MercadoPago
MP_ACCESS_TOKEN=tu_access_token_de_mercadopago
MP_PUBLIC_KEY=tu_public_key_de_mercadopago
MP_WEBHOOK_SECRET=tu_webhook_secret

# URL del frontend (para CORS y links en QR/email)
FRONTEND_URL=http://localhost:5173

# Email (opcional - para enviar QRs por correo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASS=tu_app_password
EMAIL_FROM=GianQR <tu_email@gmail.com>
