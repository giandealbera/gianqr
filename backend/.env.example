# ============================================================
#  GianQR - Variables de entorno del backend
#  Copia este archivo como .env y completa los valores.
#
#  En produccion (Render) estas variables se cargan en:
#  dashboard.render.com -> gianqr -> Environment
# ============================================================

# ---------- Servidor ----------
# Render setea PORT solo. En local, 4000.
PORT=4000
NODE_ENV=development

# ---------- Sesiones ----------
# JWT_SECRET: cadena larga y aleatoria. Si la cambias, TODAS las sesiones
# abiertas se caen y todo el mundo tiene que volver a loguearse.
JWT_SECRET=cambiar_esto_por_una_clave_secreta_muy_larga_y_aleatoria
JWT_EXPIRES_IN=8h

# Duracion cuando el usuario marca "mantener sesion iniciada" en su
# dispositivo. Existe para que el vendedor no tenga que escribir la
# contraseña cada vez que abre la app en la puerta.
JWT_EXPIRES_IN_REMEMBER=30d

# ---------- Frontend ----------
# Para CORS y para armar los links que van en los QR y en los emails.
# En produccion: https://gianqr.com
FRONTEND_URL=http://localhost:5173

# ---------- Base de datos ----------
# Con DATABASE_URL seteada el sistema usa PostgreSQL; sin ella, SQLite.
# En produccion va la connection string de Postgres.
DATABASE_URL=

# Solo aplica a SQLite. Vacio = ../../../database/gianqr.sqlite
DB_PATH=

# PGSSL=disable apaga SSL contra Postgres (util para un Postgres local).
# Vacio = SSL activado, que es lo que necesitan los Postgres administrados.
PGSSL=

# ---------- Email (Resend) ----------
# Sin RESEND_API_KEY los mails NO salen: se imprimen al log y se descartan.
# Eso deja sin funcionar la recuperacion de contraseña.
#
# Como conseguirla: crear cuenta en resend.com, verificar el dominio en
# resend.com/domains y generar la key en resend.com/api-keys.
RESEND_API_KEY=

# OJO: el dominio de MAIL_FROM tiene que ser EXACTAMENTE el que verificaste
# en Resend. Si verificaste send.gianqr.com y aca pones @gianqr.com, Resend
# rechaza todos los envios.
MAIL_FROM=GianQR <noreply@send.gianqr.com>

# Solo para desarrollo: MAIL_DEV_STUB=1 hace que el sistema se comporte como
# si el envio estuviera configurado, pero los mails se imprimen al log. Sirve
# para probar el flujo de recuperacion sin una cuenta de Resend. Se ignora
# en produccion a proposito: alli "no hay API key" tiene que seguir
# significando "el envio no esta disponible".
MAIL_DEV_STUB=

# ---------- Notificaciones push ----------
# Sin estas tres, las notificaciones quedan apagadas y la app no las ofrece.
# Generar el par de claves con:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT=mailto:tu_email@ejemplo.com

# ---------- Segundo factor ----------
# Lista (CSV) de roles para los que el 2FA es OBLIGATORIO. Si el rol del
# usuario esta en la lista y todavia no lo activo, la app lo manda a
# /configuracion/2fa y bloquea el resto hasta que lo haga.
# Vacio = opcional para todos. Recomendado: admin,owner
TFA_REQUIRED_ROLES=
TFA_ISSUER=GianQR

# ---------- Zona horaria ----------
# Las fechas se guardan en UTC. Este offset se usa para agrupar las ventas
# por dia: sin el, una venta de las 22:00 caia en el dia siguiente.
# Argentina = -3
TZ_OFFSET_HORAS=-3
